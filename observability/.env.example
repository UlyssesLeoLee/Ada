# .env.example — committed template. Copy to .env (which is
# git-ignored) on first run via `bash observability/scripts/init.sh`
# or `pwsh -File observability/scripts/init.ps1`. Every value
# below has a working dev-default; production must override.
#
# Per the secret-handling policy in
# docs/observability/09-security-design.md §4, real
# PagerDuty / Slack / SMTP secrets must NOT be committed —
# they live in .env (local dev) or in a Kubernetes Secret
# (prod, injected by External Secrets).

# --- Grafana admin (consumed by the `grafana` service) ---
GRAFANA_ADMIN_USER=ada
GRAFANA_ADMIN_PASSWORD=ada

# --- PostgreSQL exporter (consumed by `postgres-exporter`) ---
POSTGRES_USER=ada
POSTGRES_PASSWORD=ada
POSTGRES_DB=ada

# --- Phase 6 — MinIO (long-term storage) ---
# Default dev credentials. Change before any non-local use.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Phase 6 — Alertmanager integrations ---
# All four are placeholders. Replace with real values in prod.
PAGERDUTY_ROUTING_KEY=PLACEHOLDER_PAGERDUTY_ROUTING_KEY
SLACK_WEBHOOK_WARNINGS=https://hooks.slack.com/services/PLACEHOLDER
SLACK_WEBHOOK_CLUSTER=https://hooks.slack.com/services/PLACEHOLDER
SMTP_SMARTHOST=smtp.example.com:587
SMTP_FROM=alerts@ada.local
SMTP_REQUIRE_TLS=true
SMTP_AUTH_USERNAME=alerts@ada.local
SMTP_AUTH_PASSWORD=PLACEHOLDER_SMTP_PASSWORD
ALERT_DIGEST_TO=oncall@ada.local
