{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Phase 0-1 application overview: RED metrics (Rate / Errors / Duration) + node CPU / memory. Per DOC-OBS-006 §6 30 Application. Single job = ada-app, single dashboard = the on-call landing page.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "uid": "app-overview",
  "title": "App Overview (30-01)",
  "tags": ["ada", "phase-0-1", "app", "red"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {"selected": false, "text": "Prometheus", "value": "Prometheus"},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate (RPS) by service",
      "description": "RED: Rate. Phase 0-1 baseline — no business samples until ada-telemetry v0.2.0 ships.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum by (service) (rate(ada_app_requests_total[5m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10}
        }
      },
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "right"}}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error rate (5xx) by service",
      "description": "RED: Errors. Threshold 0.05 = 5% (see observability/prometheus/alerts/high_error_rate.yml).",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "sum by (service) (rate(ada_app_requests_total{status=~\"5..\"}[5m])) / sum by (service) (rate(ada_app_requests_total[5m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.01},
              {"color": "red", "value": 0.05}
            ]
          }
        }
      },
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "right"}}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p99 latency by service",
      "description": "RED: Duration. Threshold 1s (see observability/prometheus/alerts/high_latency.yml).",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (service, le) (rate(ada_app_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.5},
              {"color": "red", "value": 1.0}
            ]
          }
        }
      },
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "right"}}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Node CPU utilization",
      "description": "USE: Utilization. From node_exporter, see DOC-OBS-003 §3.1.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "1 - rate(node_cpu_seconds_total{mode=\"idle\"}[5m])",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.7},
              {"color": "red", "value": 0.9}
            ]
          }
        }
      },
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "right"}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Node memory utilization",
      "description": "USE: Utilization. node_memory_MemAvailable / node_memory_MemTotal.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.8},
              {"color": "red", "value": 0.9}
            ]
          }
        }
      },
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "right"}}
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Service health (up == 1)",
      "description": "Counts services that are reachable. 0 here means a service is down — the alt: high_error_rate / app_down rule will fire.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [
        {
          "expr": "sum(up{job=~\"ada-app|node|prometheus\"} == 1)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "graphMode": "none",
        "colorMode": "background"
      }
    }
  ]
}
