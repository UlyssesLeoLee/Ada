{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Phase 0-1 Rust runtime metrics: process CPU / memory / threads / open FDs. Source: node_exporter process metrics (ada_infra_process_*) per DOC-OBS-003 §3.5. Tokio task metrics and panics are added in Phase 1 once ada-telemetry v0.2.0 ships.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "uid": "rust-runtime",
  "title": "Rust Runtime (70-03)",
  "tags": ["ada", "phase-0-1", "runtime", "rust"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {"selected": false, "text": "Prometheus", "value": "Prometheus"},
        "hide": 0
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "query": "label_values(ada_infra_process_resident_memory_bytes, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {"selected": false, "text": "All", "value": "$__all"}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Process CPU seconds / sec",
      "description": "USE: Utilization. From node_exporter process metrics. In Phase 0 this is the node_exporter process itself; in Phase 1+ it shows each Rust crate's CPU cost.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "rate(ada_infra_process_cpu_seconds_total{instance=~\"$instance\"}[5m])",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10}
        }
      },
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "right"}}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Resident memory (RSS)",
      "description": "USE: Utilization. RSS in bytes per instance.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "ada_infra_process_resident_memory_bytes{instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10}
        }
      },
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "right"}}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Open file descriptors",
      "description": "USE: Saturation. Per FD limit. Spikes correlate with leaked connections or unclosed handles.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "ada_infra_process_open_fds{instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        },
        {
          "expr": "ada_infra_process_max_fds{instance=~\"$instance\"}",
          "legendFormat": "{{instance}} max",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10}
        }
      },
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "right"}}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Threads",
      "description": "OS threads. Rust async runtimes usually pin a small fixed pool; sharp growth is a leak signal.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "ada_infra_process_threads{instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10}
        }
      },
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "right"}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Tokio task spawn rate (Phase 1+)",
      "description": "Placeholder panel. `ada_app_*_tokio_tasks_total` lands in Phase 1 once ada-telemetry v0.2.0 (WT-1) ships; until then the query returns no data.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "sum by (service) (rate(ada_app_tokio_tasks_total[5m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10}
        }
      },
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "right"}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Panics / sec (Phase 1+)",
      "description": "Placeholder. `ada_app_panics_total` lands in Phase 1. Any non-zero value here is a Sev2.",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [
        {
          "expr": "sum by (service) (rate(ada_app_panics_total[5m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10}
        }
      },
      "options": {"legend": {"showLegend": true, "displayMode": "table", "placement": "right"}}
    }
  ]
}
